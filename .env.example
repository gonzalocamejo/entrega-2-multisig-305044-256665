# URL del RPC de Sepolia (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY"

# Clave privada de la cuenta que va a desplegar (sin el 0x inicial es opcional, viem/ethers lo aceptan con 0x)
# IMPORTANTE: usar una wallet de prueba, nunca una con fondos reales en mainnet
PRIVATE_KEY="0xPRIVATE_KEY_DE_TU_WALLET_DE_PRUEBA"

# Opcional: API key de Etherscan para verificar el contrato
ETHERSCAN_API_KEY=""

# Direcciones que serán signers del multisig (separadas por coma)
SIGNERS="0xSIGNER_1,0xSIGNER_2,0xSIGNER_3"

# Umbral mínimo de aprobaciones para ejecutar una propuesta
THRESHOLD="2"
